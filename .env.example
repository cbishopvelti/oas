# Environment variable overrides for the OAS server.
#
# Every variable here is optional. When one is set (and not empty) it replaces
# the value from the compile-time config file (config/v2_prod.exs,
# config/v3_staging.exs, ...). When it is unset or empty, the file's value is
# used. With none of them set, the server behaves exactly as before.
#
# Overrides are applied by config/runtime.exs at start-up, in every
# environment except test. At start-up the server logs which settings came
# from the environment and which came from the file (names only, never values).
#
# Usage: copy to a file outside git (e.g. /etc/oas/society.env), fill in the
# lines you need, and pass it to docker run with --env-file.
#
# IMPORTANT for a second society running from the prod image: anything you do
# not override is inherited from the Oxfordshire config file. Always set at
# least SECRET_KEY_BASE, DB_FILE, PHX_HOST, DOMAIN, ADMIN_URL, PUBLIC_URL and
# MAIL_FROM_ADDRESS. A shared SECRET_KEY_BASE means login cookies from one
# society are accepted by the other.

# --- Database ---------------------------------------------------------------

# SQLite database file. (Oas.Repo :database)
# DB_FILE=/dbs/sqlite-prod.db

# Path prefix for nightly backups; "-<timestamp>.db" is appended.
# (Oas.Repo :backup_database)
# DB_BACKUP_PATH=/dbs/sqlite-backup

# --- Web server -------------------------------------------------------------

# Signs and encrypts cookies and sockets. Generate with: mix phx.gen.secret
# Must be unique per society. (OasWeb.Endpoint :secret_key_base)
# SECRET_KEY_BASE=

# Public host name the server generates URLs for. (OasWeb.Endpoint url.host)
# PHX_HOST=server.oxfordshireacrosociety.co.uk

# Port Phoenix listens on inside the container; nginx proxies to it.
# (OasWeb.Endpoint http.port)
# PORT=4000

# Cookie domain shared by the server, admin and www hosts. Note the leading dot.
# Read at start-up, so no rebuild is needed to change it. The v3 image no
# longer bakes it in, so always pass it at run time. (OasWeb.Endpoint :domain)
# DOMAIN=.oxfordshireacrosociety.co.uk

# --- URLs of the two React apps (used in emails, redirects and links) -------

# Admin app. (:oas :app_url)
# ADMIN_URL=https://admin.oxfordshireacrosociety.co.uk

# Public booking site. (:oas :public_url)
# PUBLIC_URL=https://www.oxfordshireacrosociety.co.uk

# Outside dev and test, the server only accepts browser requests (CORS) and
# socket connections from ADMIN_URL, PUBLIC_URL and its own host (PHX_HOST), so
# these must match the URLs the browser actually uses, scheme and port included.
# Set ALLOW_ANY_ORIGIN=true to go back to accepting every origin (escape hatch
# while debugging; do not leave it on). (:oas :restrict_origins)
# ALLOW_ANY_ORIGIN=true

# --- Email ------------------------------------------------------------------
# The SMTP settings apply to both Oas.Mailer and Oas.TokenMailer. They do not
# change the adapter: a mailer configured with Swoosh.Adapters.Local stays local.

# SMTP_RELAY=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Sender for all emails. The From address is MAIL_FROM_ADDRESS
# (Oas.TokenMailer :from). The From name is the society name from the admin
# settings, unless MAIL_FROM_NAME is set, which wins. MAIL_FROM_NAME needs
# MAIL_FROM_ADDRESS to be set. Reply-To is the settings' contact email, when set.
# MAIL_FROM_ADDRESS=chris@oxfordshireacrosociety.co.uk
# MAIL_FROM_NAME=OAS

# --- Integrations -----------------------------------------------------------

# OpenAI-compatible chat completions endpoint for the LLM chat. (:oas :llm_sudio_url)
# LLM_STUDIO_URL=http://host.docker.internal:1234/v1/chat/completions

# Folder for GoCardless transaction backups. (:oas :gocardless_backup_dir)
# GOCARDLESS_BACKUP_DIR=/gocardless_backup
