FROM elixir:1.18.3

RUN apt-get update

# Certbot
RUN apt-get install -y python3 python3-venv libaugeas0
RUN python3 -m venv /opt/certbot/
RUN /opt/certbot/bin/pip install --upgrade pip
RUN /opt/certbot/bin/pip install certbot certbot-nginx
RUN ln -s /opt/certbot/bin/certbot /usr/bin/certbot

# Node
# RUN curl -sL https://deb.nodesource.com/setup_18.x | bash -
RUN curl -L https://deb.nodesource.com/nsolid_setup_deb.sh | bash -s -- 18

RUN apt-get install -y vim htop
RUN apt-get install -y nodejs
RUN apt-get install -y tmux
RUN apt-get install -y inotify-tools
RUN apt-get install -y nginx

# No URLs or domains are baked into the image. The React apps read their URLs
# from /api/config.js at run time, and the server reads ADMIN_URL, PUBLIC_URL and
# DOMAIN (cookie domain) at start-up; pass them with -e ... or --env-file.

WORKDIR /app
COPY . .

WORKDIR /app/oas-web
RUN npm install
RUN npm run build

WORKDIR /app/oas-web-public
RUN npm install
RUN npm run build

WORKDIR /app
RUN mix local.hex --force
RUN mix deps.get --force
RUN mix local.rebar --force
ARG MIX_ENV=gcloud
ENV MIX_ENV=${MIX_ENV}
RUN mix compile
# The esbuild watcher is off outside dev, so build the Phoenix JS/CSS once here
RUN mix esbuild default --minify
ENV ELIXIR_ERL_OPTIONS="-kernel shell_history enabled"

RUN cp ./nginx/v3_nginx.conf /etc/nginx/nginx.conf

VOLUME [ "/dbs", "/dbs-backup" ]

EXPOSE 80

# GET /health returns 503 when the database can't be queried.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD curl -fsS "http://localhost:${PORT:-4000}/health" > /dev/null || exit 1

